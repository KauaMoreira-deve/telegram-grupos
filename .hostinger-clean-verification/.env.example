# Copie este arquivo para .env somente no servidor. Nunca versionar o .env real.
DB_HOST=
DB_PORT=3306
DB_NAME=putaria_no_telegram
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Opcional: certificado CA em uma linha, usando \n no lugar das quebras reais.
DB_SSL_CA=

# Gere com: openssl rand -base64 48
AUTH_SECRET=
AUTH_TOKEN_TTL_MS=28800000
TRUST_PROXY=2

# Opcional
TELEGRAM_BOT_TOKEN=
