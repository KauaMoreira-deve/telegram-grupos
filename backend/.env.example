NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Para mais de uma origem, separe os endereços por vírgula.
CORS_ORIGIN=https://putarianotelegram.net,https://www.putarianotelegram.net
# Quantidade exata de proxies reversos confiáveis entre a internet e o Node.
TRUST_PROXY=1
# Em múltiplas réplicas, prefira executar npm run db:migrate na etapa de release.
RUN_MIGRATIONS=true

DB_HOST=database
DB_PORT=3306
DB_NAME=putaria_no_telegram
DB_USER=putaria_no_telegram_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Habilite para banco gerenciado ou para conexão fora da rede privada.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Certificado PEM opcional; quebras de linha podem ser representadas por \n.
DB_SSL_CA=

AUTH_SECRET=
AUTH_TOKEN_TTL_MS=28800000

# Opcional: torna a contagem de membros mais confiável para grupos públicos.
TELEGRAM_BOT_TOKEN=
